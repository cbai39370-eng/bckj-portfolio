import BCAudioPlayer from '../components/BCAudioPlayer.astro'
import BCSpatialPortal from '../components/BCSpatialPortal.astro'

import '../styles/global.scss'
---

<html lang="en" class="is-scroll-blocked theme-contrasted">
  <head>
    <meta charset="utf-8" />

    <title>BC – 剧本杀独立研发工坊 & 灵感数字枢纽</title>

    <meta
