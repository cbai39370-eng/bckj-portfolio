---
import { getDailyMotto } from '../data/daily-mottos'
const today = getDailyMotto()

// Awards are nice, but they’re not the goal.
// Focus on building quality websites, enjoying the process, and making your clients happy—that’s what really matters.
// Some amazing sites never win anything, while mediocre ones sometimes do. Awards are a niche, not a universal measure of value.
// Stay sharp, stay honest, and keep having fun.
const awards = {
  counters: {
    awwwards: ['SOTD x 16', 'Honors x 1'],
    fwa: ['SOTD x 4', 'MOTD x 2'],
    cssda: ['WOTD x 18', 'WOTM x 1'],
  },
  texts: {
    webby2025: '2025 Webby Awards Winner <br/>Best Home Page',
    commArt2017: 'Comm Arts Mag Interactive  Annual Competition Winner 2017',
    netMag2016: 'Net Mag SOTM Summer 2016',
    gsapOct2024: 'GSAP SOTM October 2024',
    gsapNov2024: 'GSAP SOTM November 2024',
    CSSDA2016: 'CSSDA Best Front-End <br/>Developer 2016',
    CSSDA2015: 'CSSDA Best Front-End <br/>Developer 2015',
  },
}
---

<section id="about" class="s-about" data-intersect>
  <div class="s__inner js-inner">
    <div class="s__block s__block--about">
      <h2 class="s__title" data-i18n="aboutTitle">About</h2>

      <div class="s__content">
        <p data-i18n="aboutP1">
          Curiosity and obsessive dedication to craft are the truest foundations of any narrative architect and creative engineer. The hunger to construct interlocking storylines, airtight clue chains, and resonant digital experiences—that is what makes building an indie narrative game so exhilarating.
        </p>

        <p data-i18n="aboutP2">
          A compelling murder mystery needs no combat combos or physics hit-pause; its soul lies in airtight locked-room logic, subtle psychological tension, and that breathless moment when all clues converge into undeniable truth. Tuning every testimony paradox and evidence tree is my daily ritual.
        </p>

        <p data-i18n="aboutP3">
          Beyond narrative game dev, this site serves as my personal digital nexus: scanning daily global trend radars, dissecting ethereal creative web gems, and curating local-first geek productivity utilities.
        </p>

        <p data-i18n="aboutP4">
          {today.aboutZh}
        </p>

        <p data-i18n="aboutP5">
          Open for narrative playtesting, creative collaborations, and technical exchanges. Stay sharp, stay honest, and keep building things with a soul.
        </p>
      </div><!-- .s__content -->
    </div><!-- .s__block -->

    <div class="s__block s__block--awards">
      <h2 class="s__title" data-i18n="awardsTitle">Awards</h2>

      <ul class="s__awards">
        <!-- 模块 1: 独立研发进程 (全宽首栏: grid 1 / 5, 1 / 2) -->
